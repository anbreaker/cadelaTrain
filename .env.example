# Copy to .env.local and fill in. Never commit real values.
# NG_APP_* variables are public: they go into the client bundle.
# Variables without NG_APP_ are server-only (api/ functions, emulator seed): never prefix them.

# --- Access (emulator allowlist seed, npm run emulators:seed) ---
ALLOWED_EMAILS=

# --- Cloudinary (photos, H7) ---
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NG_APP_CLOUDINARY_CLOUD_NAME=

# --- Firebase ---
FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_APP_ID=
NG_APP_FIREBASE_AUTH_DOMAIN=
NG_APP_FIREBASE_MESSAGING_SENDER_ID=
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_STORAGE_BUCKET=